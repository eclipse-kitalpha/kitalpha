            <style xsi:type="style:SquareDescription" labelExpression="aql:self.name +' : '+ self.eType.name +' ['+ self.eContainer(ecore::EPackage).name +']'" labelAlignment="LEFT">
              <borderColor xsi:type="description:SystemColor" href="environment:/viewpoint#//@systemColors/@entries[name='black']"/>
