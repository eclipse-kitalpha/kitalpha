          <ownedTools xsi:type="tool:ToolDescription" name="All inheritances" precondition="aql:container.oclIsKindOf(ecore::EPackage)" iconPath="/org.polarsys.kitalpha.ecore.diagram/icons/tools/hide_AllInheritances.gif">
