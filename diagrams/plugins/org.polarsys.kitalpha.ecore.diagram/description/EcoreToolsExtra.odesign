          </ownedTools>
          <ownedTools xsi:type="tool:ToolDescription" name="All References" precondition="aql:container.oclIsKindOf(ecore::EPackage)" iconPath="/org.polarsys.kitalpha.ecore.diagram/icons/tools/hide_AllReferences.gif">
