          <ownedTools xsi:type="tool:SelectionWizardDescription" name="EClasses references" precondition="service:toolsShowHidePrecondition(containerView)" candidatesExpression="aql:self.revealClassReferencesCandidates(containerView)->asOrderedSet()->asSequence()" multiple="true" tree="true" rootExpression="aql:self.revealClassReferencesRoot(containerView)->asOrderedSet()->asSequence()" childrenExpression="aql:self.eContents()->filter(ecore::EReference)" message="Select class references to hide" iconPath="/org.eclipse.emf.ecore.edit/icons/full/obj16/EReference.gif">
